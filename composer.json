{
    "name": "four-bytes/flysystem-bunny-storage",
    "description": "Flysystem v3 adapter for Bunny Storage",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Four Bytes",
            "email": "info@four-bytes.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "league/flysystem": "^3.0",
        "bunnycdn/storage": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "league/flysystem-local": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Four\\Flysystem\\BunnyStorage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Four\\Flysystem\\BunnyStorage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "vendor/bin/phpunit",
            "vendor/bin/phpstan analyse src tests --level=8"
        ],
        "phpstan": "vendor/bin/phpstan analyse src tests --level=8"
    },
    "config": {
        "sort-packages": true
    }
}
